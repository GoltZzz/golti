{
  "name": "golti",
  "version": "1.0.0",
  "description": "Golti - Personal AI Workspace",
  "main": "./out/main/index.js",
  "author": "golti",
  "homepage": "https://github.com/golti/golti",
  "scripts": {
    "dev": "node scripts/patch-electron-name.js && npx @electron/rebuild -f -w better-sqlite3 && electron-vite dev",
    "build": "npm run typecheck && electron-builder install-app-deps && electron-vite build",
    "postinstall": "electron-builder install-app-deps && node scripts/patch-electron-name.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/prepare-test-native.js && vitest run",
    "test:watch": "vitest",
    "test:go": "cd services/search-api && go test ./...",
    "sync:catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-ollama-catalog.ts",
    "build:search-runtime": "bash scripts/search-runtime/build.sh",
    "stage:search-runtime": "bash scripts/search-runtime/stage-for-pack.sh",
    "preview": "electron-vite preview",
    "build:mac": "npm run stage:search-runtime && npm run build && electron-builder --mac",
    "build:win": "npm run stage:search-runtime && npm run build && electron-builder --win",
    "build:linux": "npm run stage:search-runtime && npm run build && electron-builder --linux"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^0.475.0",
    "mermaid": "^11.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "dev.golti.app",
    "productName": "Golti",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "build/search-runtime-bundle/",
        "to": "search-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
